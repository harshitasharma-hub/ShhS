# Model weights are large. Fetch them with `hf download`, never commit them.
models/
# Training environment. Rebuild it from requirements-train.txt.
.venv/
# Trained adapters are large. The scores, logs and metrics next to them stay.
runs/*/adapter/
# State of the EC2 helper script.
.aws_state
# Console logs of long runs.
logs/
# Synthetic and field data are large. Rebuild them with scripts/synth/ and scripts/prepare/prepare_field.py.
# The finished pictures (v1, unusable, field) are small and stay in git. Raw renders, cut-outs and the zip do not.
data/synthetic/textures/
data/synthetic/probe*/
data/synthetic/*/raw/
data/field/*/raw/
data/field/*/*.zip
data/diagnostics/
# Python caches.
__pycache__/
*.pyc
# macOS folder settings.
.DS_Store
